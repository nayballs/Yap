---
import Layout from '../layouts/Layout.astro';
import HeroFlow from '../components/scenes/HeroFlow.astro';
import Steps from '../components/scenes/Steps.astro';
import TidyDiff from '../components/scenes/TidyDiff.astro';
import AppKinds from '../components/scenes/AppKinds.astro';
import MakeItYours from '../components/scenes/MakeItYours.astro';
import NotepadScene from '../components/scenes/NotepadScene.astro';
import VoiceScene from '../components/scenes/VoiceScene.astro';
import ChatScene from '../components/scenes/ChatScene.astro';
import NetworkScene from '../components/scenes/NetworkScene.astro';
import DownloadButton from '../components/DownloadButton.astro';
import DraftNote from '../components/DraftNote.astro';
import LeavesTable from '../components/LeavesTable.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import { NAME, TAGLINE, REPO_URL, RELEASES_URL, SITE_URL, DOWNLOAD_STABLE, LICENSE_URL } from '../brand';
import { faqFor } from '../data/faq';
import { stableRelease } from '../lib/release';

const rel = await stableRelease();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: NAME,
  description: TAGLINE,
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'ProductivityApplication',
  url: SITE_URL,
  downloadUrl: DOWNLOAD_STABLE,
  ...(rel?.version ? { softwareVersion: rel.version } : {}),
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
};

const facts = [
  { n: '0', text: 'accounts or emails asked for, to download or to use it' },
  { n: '14', text: 'speech models to choose from, on any graphics card or none' },
  { n: '0', text: 'cookies or trackers on this site, and no telemetry in the app' },
  { n: 'MIT', text: 'licence: the code is public to read, build and change' },
];

const ais = [
  {
    tag: 'Works offline',
    title: 'On your PC',
    text: 'One click downloads a model sized to your graphics card. Nothing to sign up for, and nothing leaves the computer.',
    amber: true,
  },
  { tag: 'Your network', title: 'On your own server', text: 'Point it at Ollama, LM Studio or any OpenAI-compatible server you run.' },
  {
    tag: 'Your key',
    title: 'With a cloud provider',
    text: `Groq, OpenAI, Anthropic, Gemini or OpenRouter, on your own key. You pay them directly; ${NAME} adds nothing.`,
  },
];
---
<Layout
  bare
  description={`${NAME}: free, open-source dictation and meeting notes for Windows. Speech and AI run on your PC; no account, no cloud required. A local alternative to Wispr Flow and Granola.`}
  jsonLd={jsonLd}
>
  <!-- 1. The hero: the promise, the button, and a dictation playing -->
  <section class="sheet hero" aria-labelledby="hero-h">
    <div class="wrap hero-copy">
      <p class="eyebrow">Free and open source · For Windows 10 and 11</p>
      <h1 id="hero-h">Press a key and talk. <span class="h1-2">{NAME} types it.</span></h1>
      <p class="lede">
        Dictation, meeting notes and a voice assistant that run on your own PC. Speak into any app and tidy text lands
        where your cursor is.
      </p>
      <div class="btn-row hero-cta">
        <DownloadButton size="lg" primary />
        <a class="btn btn-quiet btn-lg" href="#how">See how it works</a>
      </div>
      <ul class="hero-ticks" aria-label="In short">
        <li>Speech to text on your PC</li>
        <li>Keeps working with the Wi-Fi off</li>
        <li>No account, no word limit</li>
      </ul>
      <DraftNote>
        The plan puts “Watch the 60-second tour” (A16) beside the button once the video exists. Check “keeps working
        with the Wi-Fi off” per feature before launch (plan §4.1): true of dictation without a cloud model.
      </DraftNote>
    </div>
    <div class="wrap-wide hero-scene">
      <HeroFlow />
    </div>
  </section>

  <!-- 2. Plain facts, in place of a logo wall -->
  <section class="sheet sheet-ink scheme-dark facts" aria-label={`${NAME} in numbers`}>
    <ul class="wrap-wide facts-row">
      {facts.map((f) => (
        <li data-reveal><span class="num facts-n">{f.n}</span><span>{f.text}</span></li>
      ))}
    </ul>
  </section>

  <!-- 3. How it works, and messy in, tidy out -->
  <div class="sheet">
    <section class="section" id="how" aria-labelledby="how-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">How it works</p>
          <h2 id="how-h">Three steps. No account.</h2>
        </div>
        <Steps />
      </div>
    </section>

    <section class="section" aria-labelledby="tidy-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">AI cleanup</p>
          <h2 id="tidy-h">Say it however it comes out</h2>
          <p>
            The ums go, the punctuation’s fixed and the version you meant is kept. If it changed too much, <strong>Use
            what I said</strong> swaps in your exact words.
          </p>
        </div>
        <TidyDiff />
        <p class="figure-note center mt-4">
          Cleanup is off until you choose a model: one that runs on your PC, or a provider you have a key for. Its style
          follows the app: more formal in email, casual in chat, literal in AI prompts.
        </p>
      </div>
    </section>
  </div>

  <!-- 4. Private by how it's built -->
  <section class="sheet sheet-ink scheme-dark section privacy" aria-labelledby="priv-h">
    <div class="wrap split split-media">
      <div class="stack priv-copy" data-reveal>
        <p class="eyebrow">Private by how it’s built</p>
        <h2 id="priv-h">Your voice doesn’t leave your PC. Here’s how to check.</h2>
        <p class="lede">
          Not “encrypted and deleted later”: turned into text on your own graphics card or processor. Settings lists
          every connection {NAME} makes, by purpose and host, so you can see for yourself.
        </p>
        <ul class="ticks priv-ticks">
          <li>No telemetry, no analytics, no account needed</li>
          <li>The AI runs on your PC, your own server, or a provider you choose</li>
          <li>Meetings, notes and history stay on your PC</li>
        </ul>
        <p><a class="more" href="/privacy">How privacy works</a></p>
      </div>
      <div data-reveal>
        <NetworkScene />
        <p class="scene-note">Drawn from Settings → Privacy &amp; data → Network connections, with a made-up day.</p>
      </div>
    </div>
    <div class="wrap mt-5" data-reveal>
      <LeavesTable short />
    </div>
  </section>

  <!-- 5. Windows depth, and the words that are yours -->
  <div class="sheet">
    <section class="section" aria-labelledby="where-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">Made for Windows</p>
          <h2 id="where-h">It knows where it’s typing</h2>
          <p>Pasting into Windows apps has a lot of small rules. {NAME} follows them, so you don’t have to.</p>
        </div>
        <AppKinds />
      </div>
    </section>

    <section class="section" aria-labelledby="words-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">Made yours</p>
          <h2 id="words-h">Your names and jargon, spelled right</h2>
          <p>Teach {NAME} a word once and it stays taught.</p>
        </div>
        <MakeItYours />
        <p class="center mt-4"><a class="more" href="/dictation">Everything dictation does</a></p>
      </div>
    </section>
  </div>

  <!-- 6. Meetings -->
  <section class="sheet sheet-ink scheme-dark section meet" aria-labelledby="meet-h">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Meetings</p>
        <h2 id="meet-h">Notes from every call, made on your PC</h2>
        <p>
          {NAME} notices a Teams, Zoom or Meet call and asks before it takes notes. No bot joins: it hears your
          microphone and your PC’s sound. Afterwards, a summary and an action plan whose owners and dates are checked
          against what was said.
        </p>
      </div>
    </div>
    <div class="wrap-wide" data-reveal>
      <NotepadScene />
    </div>
    <div class="wrap">
      <ul class="meet-points">
        <li data-reveal>
          <h3>What did I miss?</h3>
          <p>Zoned out for a minute? One tap catches you up on what was just said.</p>
        </li>
        <li data-reveal>
          <h3>Ask across meetings</h3>
          <p>Search every meeting by meaning, on your PC, and get answers that cite the moment.</p>
        </li>
        <li data-reveal>
          <h3>Hidden from screen sharing</h3>
          <p>While it records, its windows are kept out of screen shares, and your dictations out of the transcript.</p>
        </li>
      </ul>
      <p class="center mt-4"><a class="more" href="/meetings">How meetings work</a></p>
      <DraftNote class="mt-3">Every meetings claim waits for the “one real call, end to end” test (plan §3.2).</DraftNote>
    </div>
  </section>

  <!-- 7. The assistant, and your choice of AI -->
  <div class="sheet">
    <section class="section" aria-labelledby="ask-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">Assistant</p>
          <h2 id="ask-h">Ask out loud. Hear the answer.</h2>
          <p>Ask from any app and hear the answer, or open Chat and have it write things up beside you.</p>
        </div>

        <div class="split split-media feature">
          <div class="stack" data-reveal>
            <h3 class="feature-h">The Voice Assistant</h3>
            <p class="lede">
              Press its shortcut in any app and ask: about your notes, your meetings, your calendar, or the web if you
              switch search on. The answer is read in a natural voice that runs on your PC, from its first sentence.
            </p>
            <p class="muted">Or select any text, in any app, and have it read to you, each word lit up as it’s read.</p>
          </div>
          <div data-reveal><VoiceScene /></div>
        </div>

        <div class="feature feature-wide">
          <div class="stack feature-copy" data-reveal>
            <h3 class="feature-h">Chat, with a document beside it</h3>
            <p class="lede">
              Ask about your meetings and notes, with sources. When the answer is worth keeping, a plan, a guide, a
              write-up, Chat writes it into a document beside the conversation, section by section.
            </p>
            <p><a class="more" href="/assistant">Chat and the assistant</a></p>
          </div>
          <div data-reveal><ChatScene /></div>
        </div>
      </div>
    </section>

    <section class="section ai" aria-labelledby="ai-h">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <p class="eyebrow">Your AI</p>
          <h2 id="ai-h">Your AI, your choice</h2>
          <p>Cleanup, Commands and Chat can use any of these. Every option is free in {NAME}.</p>
        </div>
        <div class="grid grid-3">
          {ais.map((a) => (
            <div class="card ai-card" data-reveal>
              <span class:list={['tag', a.amber && 'tag-amber']}>{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- 8. Open source, and questions -->
  <div class="sheet">
    <section class="section" aria-labelledby="oss-h">
      <div class="wrap split split-media">
        <div class="stack" data-reveal>
          <p class="eyebrow">Open source</p>
          <h2 id="oss-h">Open code, public builds</h2>
          <p class="lede">
            Every line of {NAME} is on GitHub under the MIT licence. The installers are built there in public, from the
            code you can read.
          </p>
          <div class="btn-row mt-3">
            <a class="btn btn-quiet" href={REPO_URL}>Read the code</a>
            <a class="btn btn-quiet" href={RELEASES_URL}>Release notes</a>
          </div>
        </div>
        <div class="rel" data-reveal>
          <div class="rel-head">
            <span class="rel-mark" aria-hidden="true"></span>
            <div>
              <p class="rel-title">{rel?.version ? `Version ${rel.version}` : 'The latest release'}</p>
              <p class="rel-sub">{rel?.date ? `Published ${rel.date}` : 'Built from a tagged commit'}</p>
            </div>
            <span class="tag tag-green">MIT</span>
          </div>
          <ul class="ticks rel-list">
            <li>Built by GitHub Actions in public, not on someone’s laptop</li>
            <li>New releases list each file’s SHA-256 checksum and a signed build provenance you can verify</li>
            <li>Updates are signed, and the app checks the signature before installing</li>
            <li>Issues, fixes and the docs for every part of the app are public</li>
          </ul>
          {rel?.sha256 && <p class="rel-sha"><span>SHA-256</span><code>{rel.sha256}</code></p>}
          <p class="rel-foot"><a href={LICENSE_URL}>Read the licence</a></p>
        </div>
      </div>
      <div class="wrap mt-3">
        <DraftNote>Checksums and build provenance landed on 25 Oct; the current stable (v0.1.0, 4 Oct) has neither. Confirm both on the next stable before launch (plan §4.2).</DraftNote>
      </div>
    </section>

    <Faq items={faqFor('home')} title="Questions, answered" />
  </div>

  <Closing />
</Layout>

<style>
  /* 1. Hero: centred words and the button, the dictation playing under them. */
  .hero {
    padding-block: clamp(32px, 4vw, 56px) clamp(28px, 4vw, 56px);
  }
  .hero-copy {
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }
  .hero-copy h1 {
    font-size: clamp(2.7rem, 1.2rem + 5vw, 5.2rem);
    max-width: 14ch;
  }
  .h1-2 {
    display: block;
  }
  .hero-copy .lede {
    margin-inline: auto;
    max-width: 37em;
  }
  .hero-cta {
    justify-content: center;
    margin-top: 4px;
  }
  .hero-ticks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    font-size: 0.9375rem;
    color: var(--t-fg-80);
  }
  .hero-ticks li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-ticks li::before {
    content: '';
    width: 0.85em;
    height: 0.5em;
    margin-top: -0.25em;
    border-left: 2px solid var(--t-success);
    border-bottom: 2px solid var(--t-success);
    transform: rotate(-45deg);
  }
  .hero-scene {
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  /* 2. Facts */
  .facts {
    padding-block: clamp(32px, 4vw, 52px);
  }
  .facts-row {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .facts-row li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 8px clamp(14px, 2.4vw, 32px);
    color: var(--t-fg-80);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .facts-row li + li {
    border-left: 1px solid var(--t-border);
  }
  .facts-n {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.8rem);
    line-height: 0.9;
    color: var(--t-fg);
  }
  @media (max-width: 860px) {
    .facts-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
    .facts-row li:nth-child(3) {
      border-left: 0;
    }
  }

  /* 4. Privacy */
  .priv-copy .lede {
    margin-top: 1.2rem;
  }
  .priv-ticks {
    margin-top: 1.4rem;
    color: var(--t-fg-80);
  }
  .privacy :global(.table-wrap) {
    background: var(--t-s1);
  }

  /* 6. Meetings */
  .meet-points {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  .meet-points li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding-top: 18px;
    border-top: 1px solid var(--t-border);
  }
  .meet-points p {
    color: var(--t-fg-80);
  }
  @media (max-width: 860px) {
    .meet-points {
      grid-template-columns: 1fr;
    }
  }

  /* 7. Assistant */
  .feature {
    margin-top: clamp(40px, 6vw, 88px);
  }
  .feature-wide {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }
  .feature-copy {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }
  .feature-copy .lede {
    margin-inline: auto;
  }
  .feature-h {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: 660;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .ai-card {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .ai-card .tag {
    justify-self: start;
    margin-bottom: 6px;
  }
  .ai-card h3 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .ai-card p {
    color: var(--t-fg-80);
  }

  /* 8. Open source */
  .rel {
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: 22px;
    background: var(--t-s2);
    box-shadow: 0 0 0 1px var(--t-border-subtle), var(--shadow-scene);
  }
  .rel-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--t-rule);
  }
  .rel-head .tag {
    margin-left: auto;
  }
  .rel-mark {
    flex: none;
    width: 44px;
    height: 41px;
    border-radius: 12px;
    border: 1.5px solid var(--t-key-border);
    background: var(--t-key-bg);
    box-shadow: 0 3px 0 var(--t-key-border);
  }
  .rel-title {
    font-weight: 700;
    font-size: 1.125rem;
  }
  .rel-sub {
    color: var(--t-muted);
    font-size: 0.9375rem;
  }
  .rel-list {
    gap: 12px;
    color: var(--t-fg-80);
  }
  .rel-sha {
    display: grid;
    gap: 4px;
    font-size: 0.8125rem;
    color: var(--t-muted);
  }
  .rel-sha code {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .rel-foot {
    font-size: 0.9375rem;
  }
</style>
