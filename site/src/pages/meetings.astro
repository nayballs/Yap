---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Shot from '../components/Shot.astro';
import Placeholder from '../components/Placeholder.astro';
import Keys from '../components/Keys.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import DraftNote from '../components/DraftNote.astro';
import { NAME } from '../brand';
import { faqFor } from '../data/faq';
import notesShot from '../../../docs/screenshot-notes.png';
---
<Layout
  title="Meeting notes"
  description={`Meeting notes made on your PC. ${NAME} notices your Teams, Zoom or Meet call, asks before it records, and writes notes and an action plan. No bot joins; the audio stays on your PC.`}
>
  <PageHero
    title="Meeting notes, made on your PC"
    lede={`${NAME} notices your Teams, Zoom or Meet call, asks before it takes notes, and keeps a notepad beside the call. No bot joins, and the audio stays on your computer.`}
  >
    <DraftNote>Every claim on this page waits for the “one real call, end to end” test (plan §3.2, §4.3).</DraftNote>
    <Placeholder
      slot="visual"
      id="A8"
      title="A call noticed"
      shows={`The bar’s “Take notes?” card over a made-up call window.`}
      format="PNG, light and dark"
      ratio="wide"
    />
  </PageHero>

  <section class="section ruled" aria-labelledby="when-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="when-h">Before, during and after the call</h2>
      </div>
      <ol class="phases">
        <li>
          <h3>Before</h3>
          <p>Connect Google Calendar or any calendar’s private iCal link. A card reminds you as a meeting starts, with <strong>Join &amp; take notes</strong>, and a brief gathers what you said last time and the open items, every line linked to where it came from.</p>
        </li>
        <li>
          <h3>During</h3>
          <p>The notepad docks beside the call: your own notes in <em>My thoughts</em>, the live transcript split into You and Them, and <strong>What did I miss?</strong> for the minutes you drifted off. One-tap helpers draft a question or a follow-up from what’s just been said.</p>
        </li>
        <li>
          <h3>After</h3>
          <p>A summary with the decisions and why they were made, and an action plan whose owners and dates are checked against what was actually said, so it doesn’t invent who agreed to what. Tasks you can tick off, with the moment each was said.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section ruled" aria-labelledby="notepad-h">
    <div class="wrap split split-media">
      <div class="stack">
        <h2 id="notepad-h">Find anything later</h2>
        <p class="lede">Ask across all your meetings and get answers that cite the moment: click one and the transcript opens at that line.</p>
        <p>Search finds the words, and with search by meaning switched on (a one-time download), what was meant. It all runs on your PC. Play any line back, fix a word the transcript got wrong, or transcribe the whole meeting again.</p>
      </div>
      <Shot
        src={notesShot}
        alt={`${NAME}’s notes window with a fictional meeting, Weekly product sync: the summary’s discussion points, decisions and action items, and the You and Them transcript below.`}
        caption="A screenshot from October 2026, with made-up data. The notepad beside a call (A7) and the checked action plan (A12) are still to capture."
      />
    </div>
  </section>

  <section class="section ruled" aria-labelledby="guard-h">
    <div class="wrap split">
      <div class="stack">
        <h2 id="guard-h">Guard rails, built in</h2>
        <p class="lede">The things that go wrong in real meetings, handled without you thinking about them.</p>
      </div>
      <div class="rows">
        <div class="row">
          <h3>Screen sharing</h3>
          <p>{NAME}’s windows are hidden from screen shares and recordings while it takes notes.</p>
        </div>
        <div class="row">
          <h3>A call that ended</h3>
          <p>When the meeting goes quiet, notes stop by themselves after a short countdown you can cancel.</p>
        </div>
        <div class="row">
          <h3>Started by mistake</h3>
          <p>A short recording asks whether you meant it, and can be thrown away.</p>
        </div>
        <div class="row">
          <h3>Length and disk space</h3>
          <p>A length limit (two hours unless you change it) with a warning first, and a warning before the drive fills up.</p>
        </div>
        <div class="row">
          <h3>Your dictations</h3>
          <p>Dictate a message during the call and it stays out of the meeting’s transcript.</p>
        </div>
        <div class="row">
          <h3>Sleep and unplugged mics</h3>
          <p>If your PC sleeps, notes pause cleanly; when it wakes, carry on or summarise. If your mic is unplugged, the next one takes over.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section ruled" aria-labelledby="more-h">
    <div class="wrap">
      <div class="grid grid-3">
        <div class="col">
          <span class="tag tag-amber">Beta</span>
          <h3>Who said what</h3>
          <p>Voices told apart on your PC, with names suggested from the invite and from what’s said. You confirm them. Voiceprints come from that meeting’s audio and are never kept.</p>
        </div>
        <div class="col">
          <span class="tag">Your AI apps</span>
          <h3>Meetings in Claude, ChatGPT and more</h3>
          <p>One click adds {NAME}’s MCP server to Claude, Claude Code, ChatGPT, Codex, Cursor, Gemini CLI, VS Code or Windsurf, so they can read your meetings and notes. Never your dictations.</p>
        </div>
        <div class="col">
          <span class="tag">Your choice</span>
          <h3>Start notes yourself</h3>
          <p>For a call {NAME} didn’t notice, or a meeting in the room: <Keys combo="Win+Alt+M" />. Choose per app whether it asks, always takes notes, or never does.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section ruled" aria-labelledby="mpriv-h">
    <div class="wrap split">
      <div class="stack">
        <h2 id="mpriv-h">Private by how it’s built</h2>
        <p class="lede">The audio, the transcript and the notes are kept on your PC. The AI that writes the summary runs on your PC too, or with a provider whose key you added.</p>
      </div>
      <ul class="ticks">
        <li>Each meeting’s audio kept 14 days by default, for playback and second passes, then deleted</li>
        <li>Transcripts deleted after 30, 90 or 365 days if you choose; notes and summaries stay</li>
        <li>Unlimited meetings, free</li>
        <li>Tell people you’re taking notes: the rules on consent depend on where you are</li>
      </ul>
    </div>
  </section>

  <Faq items={faqFor('meetings')} />
  <Closing title="Take notes at your next call" />
</Layout>

<style>
  .phases {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 2px solid var(--t-fg);
  }
  .phases li {
    padding: 22px 28px 8px 0;
  }
  .phases li + li {
    padding-left: 28px;
    border-left: 1px solid var(--t-rule);
  }
  .phases h3 {
    margin-bottom: 10px;
  }
  .phases p {
    color: var(--t-fg-80);
  }
  @media (max-width: 860px) {
    .phases {
      grid-template-columns: 1fr;
    }
    .phases li,
    .phases li + li {
      padding: 20px 0;
      border-left: 0;
      border-top: 1px solid var(--t-rule);
    }
    .phases li:first-child {
      border-top: 0;
    }
  }
</style>
