---
import Layout from '../layouts/Layout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { HOTKEY } from '../brand';
---
<Layout title="Page not found" description="This page doesn’t exist." stickyCta={false}>
  <section class="section">
    <div class="wrap-narrow stack nf">
      <span class="nf-key" aria-hidden="true">{HOTKEY}</span>
      <h1>There’s no page here</h1>
      <p class="lede">The link may be old, or mistyped. Try the <a href="/">home page</a> or the <a href="/faq">questions and answers</a>.</p>
      <div class="btn-row mt-3"><DownloadButton /></div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    padding-block: 48px;
  }
  .nf-key {
    display: grid;
    place-items: center;
    width: 72px;
    height: 68px;
    border-radius: 16px;
    border: 1.5px solid var(--t-key-border);
    background: var(--t-key-bg);
    color: var(--t-key-fg);
    font-size: 1.5rem;
    font-weight: 720;
    box-shadow: 0 5px 0 var(--t-key-border);
    margin-bottom: 12px;
  }
</style>
