---
import { NAME, REPO_URL } from '../brand';
import Mark from './Mark.astro';
import DownloadButton from './DownloadButton.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const products = [
  { href: '/dictation', label: 'Dictation' },
  { href: '/meetings', label: 'Meetings' },
  { href: '/assistant', label: 'Assistant' },
];
const links = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
];
const current = (href: string) => (here === href ? 'page' : undefined);
---
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href="/" aria-current={current('/')}>
      <Mark size={30} />
      <span class="brand-name">{NAME}</span>
    </a>

    <nav class="products" aria-label="Products">
      {products.map((p) => <a href={p.href} aria-current={current(p.href)}>{p.label}</a>)}
    </nav>

    <nav class="links" aria-label="More">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a href={REPO_URL}>GitHub</a>
    </nav>

    <div class="hdr-cta">
      <DownloadButton size="sm" />
    </div>

    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </summary>
      <div class="menu-panel">
        <nav aria-label="Menu">
          <ul>
            {products.map((p) => <li><a href={p.href} aria-current={current(p.href)}>{p.label}</a></li>)}
            <li><a href="/download" aria-current={current('/download')}>Download</a></li>
            {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
            <li><a href={REPO_URL}>GitHub</a></li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--t-bg);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--header-h);
    padding-inline: clamp(16px, 2.4vw, 32px);
    max-width: 1400px;
    margin-inline: auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--t-fg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    margin-right: 8px;
  }
  .brand:hover {
    color: var(--t-fg);
  }

  /* The product switch: the app's pill tabs (an amber edge on the one you're on). */
  .products {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 12px;
    background: var(--t-s3);
    border: 1px solid var(--t-border-subtle);
  }
  .products a {
    padding: 6px 14px;
    border-radius: 9px;
    border: 1px solid transparent;
    color: var(--t-fg-80);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .products a:hover {
    color: var(--t-fg);
    background: var(--t-s2);
  }
  .products a[aria-current='page'] {
    color: var(--t-link);
    background: var(--t-primary-wash);
    border-color: var(--t-primary-line);
  }

  .links {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }
  .links a {
    color: var(--t-fg-80);
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--t-fg);
    text-decoration: underline;
    text-decoration-color: var(--t-primary-line);
    text-underline-offset: 0.35em;
  }

  .menu {
    display: none;
    position: static;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--t-border);
    background: var(--t-s2);
    color: var(--t-fg);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary svg {
    width: 20px;
    height: 20px;
  }
  .menu-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    padding: 8px 16px 20px;
    background: var(--t-bg);
    border-bottom: 1px solid var(--t-border);
    box-shadow: var(--t-shadow-menu);
  }
  .menu-panel ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .menu-panel a {
    display: block;
    padding: 12px 4px;
    border-bottom: 1px solid var(--t-rule);
    color: var(--t-fg);
    font-weight: 600;
    text-decoration: none;
  }
  .menu-panel a[aria-current='page'] {
    color: var(--t-link);
  }

  @media (max-width: 980px) {
    .links {
      display: none;
    }
    .hdr-cta {
      margin-left: auto;
    }
  }
  @media (max-width: 760px) {
    .products {
      display: none;
    }
    .menu {
      display: block;
    }
    .hdr-in {
      gap: 10px;
    }
  }
  @media (max-width: 380px) {
    .brand-name {
      display: none;
    }
  }
</style>
