---
import { NAME, REPO_URL } from '../brand';
import Mark from './Mark.astro';
import DownloadButton from './DownloadButton.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const products = [
  { href: '/dictation', label: 'Dictation' },
  { href: '/meetings', label: 'Meetings' },
  { href: '/assistant', label: 'Assistant' },
];
const links = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
];
const current = (href: string) => (here === href ? 'page' : undefined);
---
<header class="hdr" data-hdr>
  <div class="hdr-in">
    <a class="brand" href="/" aria-current={current('/')}>
      <Mark size={30} />
      <span class="brand-name">{NAME}</span>
    </a>

    <nav class="products" aria-label="Products">
      {products.map((p) => <a href={p.href} aria-current={current(p.href)}>{p.label}</a>)}
    </nav>

    <nav class="links" aria-label="More">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a href={REPO_URL} class="gh">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 .2a8 8 0 0 0-2.53 15.6c.4.07.55-.17.55-.38v-1.35c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 .2Z"/></svg>
        GitHub
      </a>
    </nav>

    <div class="hdr-cta">
      <DownloadButton size="sm" />
    </div>

    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </summary>
      <div class="menu-panel">
        <nav aria-label="Menu">
          <ul>
            {products.map((p) => <li><a href={p.href} aria-current={current(p.href)}>{p.label}</a></li>)}
            <li><a href="/download" aria-current={current('/download')}>Download</a></li>
            {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
            <li><a href={REPO_URL}>GitHub</a></li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  // A soft shadow under the floating header once the page has scrolled.
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  if (hdr) {
    const update = () => hdr.classList.toggle('is-scrolled', window.scrollY > 8);
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 10px var(--sheet-gap) 10px;
    pointer-events: none;
  }
  .hdr-in {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 58px;
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: 12px 8px;
    border-radius: 18px;
    background: var(--t-s1);
    box-shadow: 0 0 0 1px var(--t-border-subtle), var(--t-shadow-sm);
    transition: box-shadow 200ms var(--ease);
    pointer-events: auto;
  }
  .is-scrolled .hdr-in {
    box-shadow: 0 0 0 1px var(--t-border), 0 10px 30px -12px rgb(50 40 20 / 0.25);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 4px;
    color: var(--t-fg);
    text-decoration: none;
    font-weight: 720;
    font-size: 1.1875rem;
    letter-spacing: -0.025em;
    border-radius: 10px;
  }
  .brand:hover {
    color: var(--t-fg);
  }

  /* The product switch: the app's pill tabs. */
  .products {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 12px;
    background: var(--t-s3);
    border: 1px solid var(--t-border-subtle);
  }
  .products a {
    padding: 6px 14px;
    border-radius: 9px;
    border: 1px solid transparent;
    color: var(--t-fg-80);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .products a:hover {
    color: var(--t-fg);
    background: var(--t-s2);
  }
  .products a[aria-current='page'] {
    color: var(--t-fg);
    background: var(--t-s2);
    border-color: var(--t-border);
    box-shadow: var(--t-shadow-sm);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border-radius: 9px;
    color: var(--t-fg-80);
    font-size: 0.9375rem;
    font-weight: 580;
    text-decoration: none;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--t-fg);
    background: var(--t-s3);
  }
  .gh svg {
    width: 16px;
    height: 16px;
  }

  .menu {
    display: none;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--t-border);
    background: var(--t-s2);
    color: var(--t-fg);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary svg {
    width: 20px;
    height: 20px;
  }
  .menu-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    padding: 6px 16px 14px;
    border-radius: 18px;
    background: var(--t-s1);
    box-shadow: 0 0 0 1px var(--t-border), var(--t-shadow-menu);
  }
  .menu-panel ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .menu-panel li + li a {
    border-top: 1px solid var(--t-rule);
  }
  .menu-panel a {
    display: block;
    padding: 13px 4px;
    color: var(--t-fg);
    font-weight: 620;
    text-decoration: none;
  }
  .menu-panel a[aria-current='page'] {
    color: var(--t-link);
  }

  @media (max-width: 1060px) {
    .links {
      display: none;
    }
    .hdr-cta {
      margin-left: auto;
    }
  }
  @media (max-width: 780px) {
    .products {
      display: none;
    }
    .menu {
      display: block;
    }
    .hdr-in {
      gap: 8px;
      height: 56px;
      padding-inline: 8px 6px;
    }
  }
  @media (max-width: 400px) {
    .brand-name {
      display: none;
    }
  }
</style>
