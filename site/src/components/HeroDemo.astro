---
// The keycap demo (site plan A1): a chat app, the bar above the taskbar, and
// a big amber key. Pressing it (click, Enter/Space, or the real F9 key while
// the demo is on screen) plays one dictation as the app does it: the bar
// listens, the words appear as they're heard, the tidy text is pasted into
// the message box, and the bar offers "Use what I said". Without script, or
// before the first press, it shows the finished result: what was said, and
// what was typed. All HTML and CSS; the strings are fictional.
import { HOTKEY } from '../brand';

const said = 'um so can we move the design review to Thursday, no wait, Friday at ten, and I’ll send the deck before then';
// A chat app drops a short message's full stop, as the app does.
const typed = 'Can we move the design review to Friday at 10? I’ll send the deck before then';
---
<div class="demo" data-demo data-state="done">
  <div class="desk">
    <div class="app" role="img" aria-label="A team chat app with a message box">
      <div class="app-top" aria-hidden="true">
        <span class="app-dots"><i></i><i></i><i></i></span>
        <span class="app-title"># design-review</span>
      </div>
      <div class="app-body" aria-hidden="true">
        <div class="msg"><span class="av av-1">P</span><div><b>Priya</b><p>Has anyone got a slot for the design review this week?</p></div></div>
        <div class="msg"><span class="av av-2">I</span><div><b>Imogen</b><p>Thursday is full for me</p></div></div>
      </div>
      <div class="composer">
        <p class="typed" data-typed>{typed}</p>
        <p class="placeholder" aria-hidden="true">Message #design-review</p>
      </div>
    </div>

    <div class="heard" data-heard>
      <span class="heard-label" data-heard-label>You said</span>
      <p data-heard-text>{said}</p>
    </div>

    <div class="pill-slot" aria-hidden="true">
      <div class="pill" data-pill>
        <span class="wave">{Array.from({ length: 11 }, () => <i></i>)}</span>
        <span class="pill-text" data-pill-text></span>
      </div>
    </div>
    <div class="taskbar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>

  <div class="keywrap">
    <button class="bigkey" type="button" data-key aria-describedby="demo-cap">
      <span class="sr-only">Press </span>{HOTKEY}<span class="sr-only"> to play a dictation</span>
    </button>
    <p class="demo-cap" id="demo-cap">Press <kbd>{HOTKEY}</kbd>, or this key, to watch a dictation. Shown with AI cleanup on; it’s off until you choose a model.</p>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const key = q<HTMLButtonElement>('[data-key]');
    const heardText = q('[data-heard-text]');
    const heardLabel = q('[data-heard-label]');
    const pillText = q('[data-pill-text]');
    const live = q('[data-live]');
    const typed = q('[data-typed]');
    const said = heardText.textContent ?? '';
    const words = said.split(' ');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timers: number[] = [];
    let state = 'done';
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };
    const set = (s: string) => {
      state = s;
      root.dataset.state = s;
    };
    const tap = () => {
      key.classList.add('is-down');
      later(170, () => key.classList.remove('is-down'));
    };

    const finish = () => {
      // The second press: stop, tidy, paste.
      clear();
      tap();
      heardText.textContent = said;
      set('tidying');
      pillText.textContent = 'Tidying up';
      later(reduced ? 300 : 850, () => {
        set('pasted');
        heardLabel.textContent = 'You said';
        pillText.textContent = 'Use what I said';
        live.textContent = `Typed: ${typed.textContent}`;
        later(2600, () => {
          set('done');
          pillText.textContent = '';
        });
      });
    };

    const start = () => {
      clear();
      tap();
      set('listening');
      heardLabel.textContent = 'Listening';
      pillText.textContent = '';
      live.textContent = 'Listening';
      if (reduced) {
        heardText.textContent = said;
        later(900, finish);
        return;
      }
      heardText.textContent = '';
      words.forEach((w, i) => later(260 + i * 170, () => (heardText.textContent += (i ? ' ' : '') + w)));
      later(260 + words.length * 170 + 500, finish);
    };

    const press = () => (state === 'listening' ? finish() : start());
    key.addEventListener('click', press);

    // The real key, while the demo is on screen and nothing else wants it.
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(root);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'F9' || !visible || e.repeat) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      e.preventDefault();
      press();
    });
  }
</script>

<style>
  .demo {
    position: relative;
  }

  /* The desktop: the window frame's colour, a chat app, the bar, a taskbar. */
  .desk {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: clamp(16px, 3vw, 28px) clamp(14px, 3vw, 28px) 0;
    border-radius: 20px;
    background: var(--t-bg);
    border: 1px solid var(--t-border-subtle);
    overflow: hidden;
  }

  .app {
    width: 100%;
    background: var(--t-s2);
    border: 1px solid var(--t-border);
    border-radius: 12px;
    box-shadow: var(--t-shadow-menu);
    overflow: hidden;
    text-align: left;
  }
  .app-top {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding-inline: 14px;
    background: var(--t-s3);
    border-bottom: 1px solid var(--t-border-subtle);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .app-dots {
    display: flex;
    gap: 5px;
  }
  .app-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--t-raised);
  }
  .app-body {
    display: grid;
    gap: 12px;
    padding: 16px 16px 6px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .msg {
    display: flex;
    gap: 10px;
  }
  .msg b {
    font-weight: 650;
    font-size: 0.875rem;
  }
  .msg p {
    color: var(--t-fg-80);
  }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .av-1 {
    background: color-mix(in srgb, var(--t-success) 20%, var(--t-s2));
    color: var(--t-success-text);
  }
  .av-2 {
    background: var(--t-primary-wash);
    color: var(--t-link);
  }
  .composer {
    position: relative;
    margin: 10px 14px 14px;
    min-height: 66px;
    padding: 10px 12px;
    border: 1px solid var(--t-border);
    border-radius: 10px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .placeholder {
    position: absolute;
    inset: 10px 12px auto;
    color: var(--t-muted-70);
    opacity: 0;
  }
  .typed {
    color: var(--t-fg);
  }

  /* The live words: the bar's preview card, in the bar's own colours. */
  .heard {
    width: min(100%, 400px);
    padding: 10px 14px 12px;
    border-radius: 12px;
    background: var(--bar-surface);
    border: 1px solid var(--bar-border);
    box-shadow: var(--bar-shadow);
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--bar-text-muted);
    text-align: left;
    min-height: 4.6em;
  }
  .heard-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--bar-text);
    margin-bottom: 2px;
  }

  /* The bar: a small pill above the taskbar; a capsule with a waveform while it
     listens. Its slot keeps the capsule's height, so nothing below moves. */
  .pill-slot {
    display: grid;
    place-items: center;
    height: 40px;
  }
  .pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 14px;
    width: 58px;
    border-radius: 999px;
    border: 1px solid var(--bar-pill-border);
    background: var(--bar-pill);
    transition:
      width 260ms var(--ease),
      height 260ms var(--ease),
      background-color 200ms;
    overflow: hidden;
  }
  .wave {
    display: none;
    align-items: center;
    gap: 3px;
    height: 18px;
  }
  .wave i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--bar-wave);
    transform: scaleY(0.25);
    animation: talk 900ms ease-in-out infinite;
    animation-play-state: paused;
  }
  .wave i:nth-child(2n) { animation-delay: -300ms; animation-duration: 760ms; }
  .wave i:nth-child(3n) { animation-delay: -520ms; animation-duration: 1040ms; }
  .wave i:nth-child(5n) { animation-delay: -140ms; animation-duration: 640ms; }
  @keyframes talk {
    0%, 100% { transform: scaleY(0.22); }
    50% { transform: scaleY(1); }
  }
  .pill-text {
    display: none;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--bar-text);
    white-space: nowrap;
  }

  .taskbar {
    align-self: stretch;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-inline: calc(-1 * clamp(14px, 3vw, 28px));
    padding: 8px;
    background: color-mix(in srgb, var(--t-fg) 7%, var(--t-bg));
    border-top: 1px solid var(--t-border-subtle);
  }
  .taskbar i {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--t-fg) 14%, transparent);
  }

  /* States */
  [data-state='listening'] .pill,
  [data-state='tidying'] .pill,
  [data-state='pasted'] .pill {
    width: auto;
    height: 38px;
    padding-inline: 16px;
    background: var(--bar-surface);
    border-color: var(--bar-border);
  }
  [data-state='listening'] .wave,
  [data-state='tidying'] .wave {
    display: flex;
  }
  [data-state='listening'] .wave i {
    animation-play-state: running;
  }
  [data-state='tidying'] .wave i {
    opacity: 0.45;
  }
  [data-state='tidying'] .pill-text,
  [data-state='pasted'] .pill-text {
    display: inline;
  }
  [data-state='pasted'] .pill-text {
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--bar-button);
    color: var(--bar-button-text);
  }
  [data-state='listening'] .typed,
  [data-state='tidying'] .typed {
    visibility: hidden;
  }
  [data-state='listening'] .placeholder,
  [data-state='tidying'] .placeholder {
    opacity: 1;
  }
  [data-state='listening'] .heard-label::after {
    content: '…';
  }
  [data-state='pasted'] .typed {
    animation: landed 900ms var(--ease);
  }
  @keyframes landed {
    from { background: var(--t-primary-tint); }
    to { background: transparent; }
  }

  /* The key */
  .keywrap {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 22px;
  }
  .bigkey {
    flex: none;
    width: 96px;
    height: 92px;
    border-radius: 20px;
    border: 1.5px solid var(--t-key-border);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0) 55%),
      var(--t-key-bg);
    color: var(--t-key-fg);
    font: inherit;
    font-size: 1.9rem;
    font-weight: 720;
    letter-spacing: -0.02em;
    cursor: pointer;
    box-shadow:
      0 7px 0 var(--t-key-border),
      0 14px 26px rgb(90 55 10 / 0.22);
    transform: translateY(0);
    transition:
      transform 90ms ease-out,
      box-shadow 90ms ease-out;
  }
  .bigkey:hover {
    transform: translateY(-1px);
    box-shadow:
      0 8px 0 var(--t-key-border),
      0 16px 28px rgb(90 55 10 / 0.24);
  }
  .bigkey:active,
  .bigkey.is-down {
    transform: translateY(6px);
    box-shadow:
      0 1px 0 var(--t-key-border),
      0 4px 10px rgb(90 55 10 / 0.2);
  }
  .bigkey:focus-visible {
    outline-offset: 6px;
  }
  .demo-cap {
    font-size: 0.875rem;
    color: var(--t-muted);
    max-width: 30ch;
  }

  /* Wide screens: the key sits on the desk's corner, like a real key in front
     of the screen; its caption runs under the desk beside it. */
  @media (min-width: 1100px) {
    .keywrap {
      display: block;
      margin-top: 16px;
      padding-left: 84px;
    }
    .bigkey {
      position: absolute;
      left: -44px;
      top: calc(100% - 128px);
    }
    .demo-cap {
      max-width: 34ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave i {
      animation: none;
      transform: scaleY(0.6);
    }
  }
</style>
