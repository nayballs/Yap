---
// Every page ends the same way, on an ink sheet: the key, one line, the
// button. Pass it as `slot="after"` on a page with one paper sheet, or as a
// sheet of its own on a `bare` page.
import { HOTKEY } from '../brand';
import DownloadButton from './DownloadButton.astro';
interface Props {
  title?: string;
  line?: string;
}
const { title = `Press ${HOTKEY}. Start talking.`, line = 'For Windows 10 and 11, 64-bit. Free, with no account.' } = Astro.props;
---
<section class="sheet sheet-ink scheme-dark closing" aria-labelledby="closing-h">
  <div class="wrap closing-in" data-reveal>
    <span class="closing-key" aria-hidden="true"><span>{HOTKEY}</span></span>
    <h2 id="closing-h">{title}</h2>
    <p class="closing-line">{line}</p>
    <DownloadButton size="lg" />
  </div>
  <div class="closing-glow" aria-hidden="true"></div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    padding-block: clamp(72px, 10vw, 140px);
    text-align: center;
  }
  .closing-in {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .closing h2 {
    font-size: clamp(2.4rem, 1.3rem + 4.2vw, 5rem);
    max-width: 14ch;
  }
  .closing-line {
    color: var(--t-fg-80);
    font-size: 1.125rem;
  }
  .closing :global(.dl) {
    margin-top: 10px;
  }
  .closing-key {
    display: grid;
    place-items: center;
    width: 112px;
    height: 104px;
    margin-bottom: 14px;
    border-radius: 24px;
    border: 1.5px solid var(--t-key-border);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0) 55%),
      var(--t-key-bg);
    color: var(--t-key-fg);
    font-size: 2.1rem;
    font-weight: 740;
    letter-spacing: -0.02em;
    box-shadow:
      0 8px 0 var(--t-key-border),
      0 24px 60px rgb(232 160 50 / 0.28);
    animation: closing-press 4.8s var(--ease) 1.2s infinite;
  }
  @keyframes closing-press {
    0%, 86%, 100% {
      transform: translateY(0);
      box-shadow: 0 8px 0 var(--t-key-border), 0 24px 60px rgb(232 160 50 / 0.28);
    }
    90% {
      transform: translateY(6px);
      box-shadow: 0 2px 0 var(--t-key-border), 0 10px 30px rgb(232 160 50 / 0.2);
    }
  }
  .closing-glow {
    position: absolute;
    inset: auto 0 -40% 0;
    height: 80%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 50%, rgb(226 152 42 / 0.16), transparent 70%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .closing-key {
      animation: none;
    }
  }
</style>
