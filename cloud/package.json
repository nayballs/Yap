{
  "name": "yap-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Yap accounts: sign-in server (Better Auth on Cloudflare Workers + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "mock:provider": "node dev/mock-provider.mjs",
    "test:e2e": "node dev/e2e-phone.mjs .dev.vars",
    "schema": "auth generate --config auth.cli.ts --output .wrangler/schema.sql -y",
    "db:migrate:local": "wrangler d1 migrations apply yap-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply yap-auth --remote"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.7",
    "better-auth": "1.7.7",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "auth": "1.7.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.146.0"
  }
}
