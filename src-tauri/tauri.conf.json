{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yap",
  "version": "0.1.1",
  "identifier": "com.yap.dictation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:51437",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Yap",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "center": true
      },
      {
        "label": "onboarding",
        "title": "Welcome to Yap",
        "width": 620,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "center": true
      },
      {
        "label": "notepad",
        "title": "Meeting notes · Yap",
        "width": 560,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "center": false
      },
      {
        "label": "overlay",
        "title": "Yap",
        "width": 520,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "publisher": "Nathan",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.contextmirror.yap"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDM0OTRGRkJGOTEzMkIKUldRckUvbjdUMGxEYzU3WUVWcm53MnRYL1hyQVBLTHdpcVhxZmplbU91bFJsbkpiS09ReEE3aUQK",
      "endpoints": [
        "https://github.com/nayballs/Yap/releases/latest/download/latest.json"
      ]
    }
  }
}
