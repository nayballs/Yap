#!/bin/sh
# Yap's pre-push privacy guard: blocks a push that would publish a private
# term (the maintainer's list, kept outside every repo), an API key, a real
# email address or a UK phone number. See scripts/privacy-guard.mjs.
# Installed with `npm run hooks:install` (git config core.hooksPath .githooks).
# Only for a false positive, after checking it really is one: git push --no-verify
guard="$(git rev-parse --show-toplevel)/scripts/privacy-guard.mjs"
if [ ! -f "$guard" ]; then
  # A worktree on an older branch: the main checkout's copy.
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  guard="$(dirname "$common")/scripts/privacy-guard.mjs"
fi
if [ ! -f "$guard" ]; then
  echo "privacy-guard: scripts/privacy-guard.mjs not found; this push wasn't checked" >&2
  exit 0
fi
exec node "$guard" "$@"
