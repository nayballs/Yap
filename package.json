{
  "name": "yap",
  "version": "0.1.1",
  "description": "Yap — a tiny local voice dictation pill",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:app": "node e2e/build.mjs && playwright test -c e2e",
    "test:app:build": "node e2e/build.mjs",
    "test:real": "node e2e-real/build.mjs && playwright test -c e2e-real",
    "test:real:build": "node e2e-real/build.mjs",
    "test:link": "node --test e2e-link/dsp.test.mjs && playwright test -c e2e-link",
    "eval": "node scripts/eval.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "privacy:scan": "node scripts/privacy-guard.mjs --scan-tree",
    "test:privacy": "node --test scripts/privacy-guard.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-blockquote": "3.32.2",
    "@tiptap/extension-bold": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/extension-code-block": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-heading": "3.32.2",
    "@tiptap/extension-horizontal-rule": "3.32.2",
    "@tiptap/extension-italic": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-strike": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "jsdom": "26.1.0",
    "svelte": "^5",
    "vite": "^6.4.4"
  }
}
