{
  "name": "yap-repo",
  "private": true,
  "description": "Yap: the desktop app (desktop/), the phone app (phone/), the accounts service (cloud/) and the website (site/)",
  "type": "module",
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w desktop",
    "build": "npm run build -w desktop",
    "preview": "npm run preview -w desktop",
    "tauri": "npm run tauri -w desktop --",
    "test:app": "npm run test:app -w desktop --",
    "test:app:build": "npm run test:app:build -w desktop",
    "test:real": "npm run test:real -w desktop --",
    "test:real:build": "npm run test:real:build -w desktop --",
    "test:link": "node --test phone/web/tests/dsp.test.mjs && playwright test -c phone/web/tests",
    "eval": "node scripts/eval.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "privacy:scan": "node scripts/privacy-guard.mjs --scan-tree",
    "test:privacy": "node --test scripts/privacy-guard.test.mjs",
    "pins:check": "node scripts/check-pins.mjs",
    "test:pins": "node --test scripts/check-pins.test.mjs",
    "test:launcher": "node --test scripts/dev-launcher.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
